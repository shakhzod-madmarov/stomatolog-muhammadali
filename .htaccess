# ----------------------------------------------------------------------
# Dr. MuhammadAli Davronov (stomatolog-muhammadali.uz) - Apache / LiteSpeed Configuration
# Production Hardened Security & Performance
# ----------------------------------------------------------------------

# 1. Disable directory listing / index browsing
Options -Indexes

# 2. Block access to hidden, sensitive, environment, and backup files
<FilesMatch "(^\.|\.env|package\.json|package-lock\.json|\.git|\.yml|\.yaml|\.log|\.md|\.sql|\.bak|\.swp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# URL Rewriting & SPA Routing
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?stomatolog-muhammadali\.uz$ [NC]
  RewriteRule ^(.*)$ https://stomatolog-muhammadali.uz/$1 [L,R=301]

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.stomatolog-muhammadali\.uz$ [NC]
  RewriteRule ^(.*)$ https://stomatolog-muhammadali.uz/$1 [L,R=301]

  # If a pre-rendered index.html exists in a matching subdirectory, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # If the requested file or folder physically exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Fallback: send all other requests to index.html for React Router
  RewriteRule ^ index.html [L]
</IfModule>

# Custom Error Documents
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# GZIP & DEFLATE Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Browser Caching Headers
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Manifest: Always validate
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"

  # CSS, JS: 1 year (cache-busted by Vite hashes)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media & Images: 1 month
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Hardened Security Headers (OWASP Top 10 Defenses)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Prevent Clickjacking (iframe embedding from third-party domains)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Legacy XSS Filter for older browsers
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy: send origin only on cross-origin requests
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Enforce strict HTTPS (HSTS) for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Disable risky hardware capabilities for third-party contexts
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Block Adobe Flash / PDF cross-domain access
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # Content Security Policy (CSP)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://dentist-medinson-license.uz https://*.medinson-license.uz https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://dentist-medinson-license.uz https://*.medinson-license.uz; frame-src 'self' https://yandex.uz https://*.yandex.uz https://yandex.ru https://*.yandex.ru https://www.google.com https://*.google.com; base-uri 'self'; form-action 'self';"
</IfModule>
